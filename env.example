# Copy to .env.local and fill in. Never commit .env.local.

# ---- LLM (server only; any OpenAI-compatible provider) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b          # primary agent model
LLM_FALLBACK_MODEL=openai/gpt-oss-20b   # used only if the primary errors
LLM_BASE_URL=https://api.groq.com/openai/v1

# ---- Speech ----
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=            # empty = reuse LLM_API_KEY
TTS_PROVIDER=browser    # browser speechSynthesis (no key needed)

# ---- Swytchcode ----
# Locally the CLI uses your `swytchcode login` session. On a server set a service token (swy_key_...).
SWYTCHCODE_TOKEN=
SWYTCHCODE_PROJECT_DIR=.   # folder that contains .swytchcode/
SWYTCHCODE_BIN=            # optional; defaults to node_modules/.bin/swytchcode(.cmd)

# ---- App ----
DATABASE_PATH=data/relay.db
AUTH_SECRET=               # 32+ random chars; required when APP_PASSCODE is set
APP_PASSCODE=              # empty = no login screen (local single-owner use)
